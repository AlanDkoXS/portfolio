# Netlify headers — https://docs.netlify.com/routing/headers/
# Asset file names aren't fingerprinted, so caches are moderate and use
# stale-while-revalidate: visitors get instant loads and pick up changes on
# the next visit after the max-age expires.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/docs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# CSS/JS change with every deploy and have no hash in the name: always
# revalidate (cheap 304 via ETag) so visitors never get a stale theme/script.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Perfil para IA: texto plano UTF-8 (acentos) y se puede leer desde otros orígenes
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
